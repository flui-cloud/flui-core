# SonarQube local scan artifacts
.sonar/
.scannerwork/

# Local scratch scripts and smoke-test run output (not committed)
/runs/
/scripts/_*.ts

# Internal documentation (reference only, not for public repo)
internal-docs/

# Local MCP server registration: points at a bridge under the operator's home
